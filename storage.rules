rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Gambar publik (logo tim, foto player): semua membaca; hanya staf (peran dibaca dari Firestore users/{uid}) menulis.
    match /img/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'panitia']
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
